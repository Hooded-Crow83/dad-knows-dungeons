<footer class="site-footer">
  <div class="container">
    <div class="footer__top">
      <div>
        <a class="footer__brand" href="/">{{ site.name }}</a>
        <p class="footer__tagline">{{ site.description }}</p>
        <ul class="footer__social">
          <li>
            <a href="{{ site.social.youtube }}" aria-label="Watch on YouTube">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.5V8.5L15.8 12l-6.2 3.5Z"/></svg>
            </a>
          </li>
          <li>
            <a href="{{ site.social.instagram }}" aria-label="Follow on Instagram">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 2.06.25 2.5.43a5 5 0 0 1 1.8 1.17 5 5 0 0 1 1.17 1.8c.18.44.37 1.3.43 2.5.06 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.06 1.2-.25 2.06-.43 2.5a5 5 0 0 1-1.17 1.8 5 5 0 0 1-1.8 1.17c-.44.18-1.3.37-2.5.43-1.3.06-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.06-2.06-.25-2.5-.43a5 5 0 0 1-1.8-1.17 5 5 0 0 1-1.17-1.8c-.18-.44-.37-1.3-.43-2.5C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.06-1.2.25-2.06.43-2.5a5 5 0 0 1 1.17-1.8 5 5 0 0 1 1.8-1.17c.44-.18 1.3-.37 2.5-.43C8.4 2.2 8.8 2.2 12 2.2Zm0 3.05a6.75 6.75 0 1 0 0 13.5 6.75 6.75 0 0 0 0-13.5Zm0 11.13a4.38 4.38 0 1 1 0-8.76 4.38 4.38 0 0 1 0 8.76Zm7-11.4a1.58 1.58 0 1 1-3.15 0 1.58 1.58 0 0 1 3.15 0Z"/></svg>
            </a>
          </li>
          <li>
            <a href="{{ site.social.rss }}" aria-label="Subscribe via RSS">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 4a16 16 0 0 1 16 16h-3.2A12.8 12.8 0 0 0 4 7.2Zm0 6.4A9.6 9.6 0 0 1 13.6 20h-3.2A6.4 6.4 0 0 0 4 13.6ZM4 17a3 3 0 1 1 0 6 3 3 0 0 1 0-6Z"/></svg>
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="footer__heading">Site</p>
        <ul class="footer__list">
          {% for item in site.nav %}
          <li><a href="{{ item.url }}">{{ item.text }}</a></li>
          {% endfor %}
        </ul>
      </div>

      <div>
        <p class="footer__heading">Listen</p>
        <ul class="footer__list">
          <li><a href="{{ site.social.spotify }}">Spotify</a></li>
          <li><a href="{{ site.social.apple }}">Apple Podcasts</a></li>
          <li><a href="{{ site.social.youtube }}">YouTube</a></li>
          <li><a href="{{ site.social.rss }}">RSS feed</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <p>&copy; {{ currentYear }} {{ site.name }}. All rights reserved.</p>
      <p><a href="{{ site.social.rss }}">feed.xml</a> · <a href="/sitemap.xml">sitemap.xml</a></p>
    </div>
  </div>
</footer>
