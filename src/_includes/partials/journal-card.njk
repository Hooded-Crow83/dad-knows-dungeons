{# Usage: {% include "partials/journal-card.njk" %} inside a loop with `post` set #}
<article class="card">
  <div class="card__media">
    <img src="{{ post.data.coverImage or '/assets/images/placeholder-journal.svg' }}" alt="" loading="lazy">
  </div>
  <div class="card__body">
    {% if post.data.campaign %}<p class="card__eyebrow">{{ post.data.campaign }}</p>{% endif %}
    <h3 class="card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    <p class="card__excerpt">{{ post.data.excerpt or (post.templateContent | excerpt) }}</p>
    <p class="card__meta">
      <span>{{ post.date | readableDate }}</span>
      <span>{{ post.templateContent | readingTime }}</span>
    </p>
  </div>
</article>
