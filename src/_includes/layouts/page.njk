---
layout: layouts/base.njk
---
<article class="section">
  <div class="container container--narrow">
    {% if eyebrow %}<p class="hero__eyebrow">{{ eyebrow }}</p>{% endif %}
    <h1>{{ title }}</h1>
    {% if lede %}<p class="hero__lede">{{ lede }}</p>{% endif %}
    <div class="prose">
      {{ content | safe }}
    </div>
  </div>
</article>
